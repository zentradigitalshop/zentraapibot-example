# Admin dashboard — its own environment, separate from the bot's.
#
# Copy this to dashboard/.env.local for `npm run dev`, or set the same two
# names in your deploy platform's project settings (Vercel: Project →
# Settings → Environment Variables). See the root ../.env.example for the
# full picture of how this app relates to the bot.

# The SAME database the bot writes to — Supabase Project Settings →
# Database → Connect → SESSION pooler (port 5432, not 6543). See
# src/lib/db.ts for why the session pooler and not the transaction pooler.
DATABASE_URL=

# One shared password gating the whole dashboard — there is no per-admin
# account system. Make it long and random; rotating it signs out every
# existing session at once. See src/lib/session.ts for the reasoning.
ADMIN_PASSWORD=
